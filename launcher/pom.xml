<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.foggy.navigator</groupId>
        <artifactId>foggy-navigator-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>launcher</artifactId>
    <name>Application Launcher</name>
    <description>应用启动器 - 负责打包和启动所有模块</description>

    <dependencies>
        <!-- Shared deployment identity and authorization foundation contracts. -->
        <dependency>
            <groupId>com.foggy.navigator</groupId>
            <artifactId>navigator-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.foggy.navigator</groupId>
            <artifactId>navigator-spi</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Session Module - 会话管理模块 -->
        <dependency>
            <groupId>com.foggy.navigator</groupId>
            <artifactId>session-module</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Business Agent - Client App 接入与业务 Worker 公共控制面 -->
        <dependency>
            <groupId>com.foggy.navigator</groupId>
            <artifactId>business-agent-module</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Metadata Config Module - 元数据配置模块 -->
        <dependency>
            <groupId>com.foggy.navigator</groupId>
            <artifactId>metadata-config-module</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Claude Worker Agent - Claude Code 远程控制模块 -->
        <dependency>
            <groupId>com.foggy.navigator</groupId>
            <artifactId>claude-worker-agent</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Codex Worker Agent - OpenAI Codex 远程控制模块 -->
        <dependency>
            <groupId>com.foggy.navigator</groupId>
            <artifactId>codex-worker-agent</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.foggy.navigator</groupId>
            <artifactId>gemini-worker-agent</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- LangGraph Biz Worker - 业务 Agent 工作器模块 -->
        <dependency>
            <groupId>com.foggy.navigator</groupId>
            <artifactId>langgraph-biz-worker</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Task Assistant - AI 任务通知助手模块 -->
        <dependency>
            <groupId>com.foggy.navigator</groupId>
            <artifactId>task-assistant</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Runtime health endpoint for Docker Compose and release checks -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>9.0.1</version>
                <configuration>
                    <dotGitDirectory>${project.basedir}/../.git</dotGitDirectory>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
                    <commitIdGenerationMode>full</commitIdGenerationMode>
                    <includeOnlyProperties>
                        <includeOnlyProperty>^git.branch$</includeOnlyProperty>
                        <includeOnlyProperty>^git.commit.id.full$</includeOnlyProperty>
                        <includeOnlyProperty>^git.commit.id.abbrev$</includeOnlyProperty>
                        <includeOnlyProperty>^git.commit.time$</includeOnlyProperty>
                        <includeOnlyProperty>^git.dirty$</includeOnlyProperty>
                    </includeOnlyProperties>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                </configuration>
                <executions>
                    <execution>
                        <id>git-build-metadata</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>verify-launcher-provenance</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <available file="${project.build.outputDirectory}/git.properties"
                                           property="launcher.git.properties.exists"/>
                                <fail unless="launcher.git.properties.exists"
                                      message="Launcher provenance is missing: target/classes/git.properties"/>
                                <property file="${project.build.outputDirectory}/git.properties"/>
                                <exec executable="git" dir="${maven.multiModuleProjectDirectory}"
                                      outputproperty="launcher.actual.git.commit" failonerror="true">
                                    <arg value="rev-parse"/>
                                    <arg value="HEAD"/>
                                </exec>
                                <condition property="launcher.git.commit.matches">
                                    <equals arg1="${git.commit.id.full}" arg2="${launcher.actual.git.commit}" trim="true"/>
                                </condition>
                                <fail unless="launcher.git.commit.matches"
                                      message="Refusing to package stale launcher provenance: generated commit does not match repository HEAD"/>
                                <exec executable="git" dir="${maven.multiModuleProjectDirectory}"
                                      resultproperty="launcher.git.diff.exit" failonerror="false">
                                    <arg value="diff-index"/>
                                    <arg value="--quiet"/>
                                    <arg value="HEAD"/>
                                    <arg value="--"/>
                                </exec>
                                <condition property="launcher.git.diff.exit.valid">
                                    <or>
                                        <equals arg1="${launcher.git.diff.exit}" arg2="0"/>
                                        <equals arg1="${launcher.git.diff.exit}" arg2="1"/>
                                    </or>
                                </condition>
                                <fail unless="launcher.git.diff.exit.valid"
                                      message="Unable to determine launcher build worktree state"/>
                                <condition property="launcher.git.dirty.matches">
                                    <or>
                                        <and>
                                            <equals arg1="${git.dirty}" arg2="false" casesensitive="false"/>
                                            <equals arg1="${launcher.git.diff.exit}" arg2="0"/>
                                        </and>
                                        <and>
                                            <equals arg1="${git.dirty}" arg2="true" casesensitive="false"/>
                                            <equals arg1="${launcher.git.diff.exit}" arg2="1"/>
                                        </and>
                                    </or>
                                </condition>
                                <fail unless="launcher.git.dirty.matches"
                                      message="Refusing to package mismatched launcher provenance: generated dirty state does not match tracked worktree state"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Spring Boot Maven Plugin - 仅在此模块使用 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.foggy.navigator.launcher.FogyNavigatorApplication</mainClass>
                    <fork>true</fork>
                    <addResources>true</addResources>
                    <useTestClasspath>false</useTestClasspath>
                </configuration>
                <executions>
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Packaged only for the owner's isolated FAP Workbench canary. -->
        <profile>
            <id>fap-workbench-canary</id>
            <dependencies>
                <dependency>
                    <groupId>com.foggy.navigator</groupId>
                    <artifactId>workbench-fap-adapter</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
