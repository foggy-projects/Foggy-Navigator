{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foggy.example/contracts/codex-app-server-worker/task-respond-v1.schema.json",
  "title": "Codex App Server Worker User Input Response v1",
  "type": "object",
  "required": ["request_id", "answers"],
  "properties": {
    "request_id": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 256 },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      ]
    },
    "answers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1, "maxLength": 16384 },
          {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 16384 }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
