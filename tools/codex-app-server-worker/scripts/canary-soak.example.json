{
  "profile": "production",
  "navigator": {
    "baseUrl": "http://127.0.0.1:8112",
    "tasksPath": "/api/v1/tasks/operations/codex-canary",
    "tokenEnv": "NAVIGATOR_CANARY_TOKEN",
    "runtimeId": "codex-app-server-canary",
    "runtimeRevision": 1,
    "routingEpoch": 1,
    "workerId": "replace-with-physical-worker-id",
    "model": "codex-ultra",
    "providerType": "codex-app-server-worker",
    "cohortMarkerEnv": "CODEX_CANARY_COHORT_MARKER"
  },
  "workers": [
    {
      "healthUrl": "http://127.0.0.1:3062/health"
    }
  ],
  "stateFile": "../logs/operations/canary-soak-state.json",
  "sampleIntervalSeconds": 60,
  "maxSampleGapSeconds": 600,
  "requestTimeoutSeconds": 20,
  "privacyMarkerEnvNames": [
    "CODEX_CANARY_PRIVACY_MARKER"
  ]
}
