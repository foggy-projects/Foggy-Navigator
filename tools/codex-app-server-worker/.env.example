# Independent HTTP service identity.
CODEX_APP_SERVER_WORKER_PORT=3062
CODEX_APP_SERVER_WORKER_HOST=127.0.0.1
CODEX_APP_SERVER_WORKER_NAME=codex-app-server-worker-default
# Optional. Empty disables Worker HTTP authentication; non-empty requires the same Bearer token.
CODEX_APP_SERVER_WORKER_TOKEN=

# Required: comma-separated absolute workspace roots accepted by cwd validation.
# Fresh installers populate platform defaults; manual source setups must set this explicitly.
# This admission allowlist is not a filesystem sandbox for danger-full-access tasks.
CODEX_APP_SERVER_ALLOWED_CWDS=
CODEX_APP_SERVER_MAX_CONCURRENT_TASKS=32
CODEX_APP_SERVER_MAX_QUEUED_TASKS=64
CODEX_APP_SERVER_POOL_MAX_INSTANCES=6
CODEX_APP_SERVER_POOL_MAX_INSTANCES_PER_LANE=4
CODEX_APP_SERVER_POOL_MAX_QUEUE=32
CODEX_APP_SERVER_POOL_ACQUIRE_TIMEOUT_MS=30000
CODEX_APP_SERVER_POOL_IDLE_TTL_MS=300000
CODEX_APP_SERVER_POOL_MAX_LIFETIME_MS=3600000
CODEX_APP_SERVER_POOL_MAX_TASKS_PER_INSTANCE=100
CODEX_APP_SERVER_SHUTDOWN_TIMEOUT_MS=30000
CODEX_APP_SERVER_ABORT_WAIT_TIMEOUT_MS=7000
# Retire a live turn after this much time without any app-server progress event.
# The timer pauses while the Worker is explicitly waiting for request_user_input.
CODEX_APP_SERVER_TURN_STALL_TIMEOUT_MS=900000

# Required for readiness and task acceptance. Fresh installers generate and preserve this value.
CODEX_APP_SERVER_STATE_KEY=
CODEX_APP_SERVER_STATE_DIR=
# Optional lifecycle PID/stop-request directory; defaults to this package's logs/run directory.
CODEX_APP_SERVER_RUN_DIR=
# Optional operational isolation for stdout/stderr files; defaults to this package's logs directory.
CODEX_APP_SERVER_LOG_DIR=

# Runtime identity is persisted by Navigator for Worker-instance routing; it is not a child-process or Thread binding.
# runtime id max: 64 characters; explicit instance id max: 128 characters.
CODEX_APP_SERVER_RUNTIME_ID=codex-app-server-primary
CODEX_APP_SERVER_RUNTIME_REVISION=1
CODEX_APP_SERVER_INSTANCE_ID=

OPENAI_API_KEY=
OPENAI_BASE_URL=
# Required: an app-server Worker service home that is not shared with the SDK Worker.
# Fresh installers create <install-dir>/codex-home.
CODEX_HOME=
CODEX_BIZ_HOME_ROOT=
CODEX_DEFAULT_MODEL=codex-latest
CODEX_MODEL_ALIASES=
