{
  "name": "codex-agent-worker",
  "version": "1.0.25",
  "description": "OpenAI Codex Agent Worker - TypeScript SSE service",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:resume-shell": "node scripts/resume-shell-integration.mjs",
    "package:release": "node scripts/package-release.mjs",
    "publish:obs": "node scripts/publish-obs.mjs",
    "smoke:release": "node scripts/release-smoke.mjs"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.145.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
