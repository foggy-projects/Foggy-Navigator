# Codex Agent Worker Configuration
CODEX_WORKER_PORT=3051
CODEX_WORKER_HOST=0.0.0.0
CODEX_WORKER_NAME=codex-worker-default

# OpenAI API Key (default, can be overridden per-request)
OPENAI_API_KEY=sk-xxx

# OpenAI Base URL (default, can be overridden per-request)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Bearer token for authentication (optional)
CODEX_WORKER_TOKEN=
# External ingress is explicit and currently remains unready until execution
# policy (workspace/tools/sandbox/approval/network) governance is complete.
CODEX_WORKER_EXTERNAL_ENABLED=false

# Allowed working directories (comma-separated, empty = allow all)
CODEX_ALLOWED_CWDS=

# Root for per-account/actor CODEX_HOME folders.
# Required when requests pass codex_home_key.
# CODEX_BIZ_HOME_ROOT=/var/lib/codex-worker/homes

# Navigator WorkerGateway base URL for codex-biz-worker business tools.
# CODEX_NAVIGATOR_WORKER_GATEWAY_BASE_URL=http://localhost:8080
# One-time rotated Gateway identity installed only on this Worker. The SDK
# Worker currently remains fail-closed for strict forwarding until the MCP
# process can be isolated from Codex CLI/Shell environment access.
# CODEX_NAVIGATOR_WORKER_ID=
# CODEX_NAVIGATOR_WORKER_CREDENTIAL=

# Maximum concurrent tasks
CODEX_MAX_CONCURRENT_TASKS=6

# Reconcile Worker task/thread locks with actual Codex CLI processes.
CODEX_THREAD_WATCHDOG_INTERVAL_MS=5000
CODEX_THREAD_PROCESS_MISSING_GRACE_MS=10000

# Log level: debug, info, warn, error
CODEX_LOG_LEVEL=info

# Repair a missing or outdated Codex SDK to the worker-validated version during startup.
# Set to false for strict/offline environments; startup will fail if the SDK is incompatible.
CODEX_WORKER_AUTO_UPDATE_SDK=true

# Auto-upgrade URL (set automatically by remote installer, or manually)
# `codex-worker upgrade` checks latest.json at this URL for new versions
# CODEX_WORKER_URL=https://your-bucket.obs.cn-north-4.myhuaweicloud.com/codex-worker

# ---- Release config (developer only, not needed on target machines) ----
# OBS bucket path for obsutil upload
# RELEASE_OBS_BUCKET=obs://your-bucket/codex-worker
# Public HTTP download URL
# RELEASE_BASE_URL=https://your-bucket.obs.cn-north-4.myhuaweicloud.com/codex-worker
