#!/bin/bash
# codex-worker -- Unified CLI for Codex Agent Worker

set -e

INSTALL_DIR="${CODEX_WORKER_HOME:-$HOME/.codex-worker}"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$SCRIPT_DIR/../../package.json" ] && [ ! -f "$INSTALL_DIR/VERSION" ]; then
    if grep -q '"name":[[:space:]]*"codex-agent-worker"' "$SCRIPT_DIR/../../package.json" 2>/dev/null; then
        INSTALL_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
    fi
fi

if [ -f "$INSTALL_DIR/VERSION" ]; then
    VERSION=$(cat "$INSTALL_DIR/VERSION" 2>/dev/null || echo "unknown")
elif [ -f "$INSTALL_DIR/package.json" ]; then
    VERSION=$(grep '"version"' "$INSTALL_DIR/package.json" | head -1 | sed 's/.*"\([^"]*\)".*/\1/')
else
    VERSION="unknown"
fi

PORT=3051
if [ -f "$INSTALL_DIR/.env" ]; then
    _port=$(grep "^CODEX_WORKER_PORT=" "$INSTALL_DIR/.env" 2>/dev/null | cut -d= -f2)
    [ -n "$_port" ] && PORT="$_port"
fi

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; GRAY='\033[0;37m'; NC='\033[0m'

cmd_start() {
    echo -e "${CYAN}Starting Codex Agent Worker v${VERSION}...${NC}"
    bash "$INSTALL_DIR/start.sh"
}

cmd_stop() {
    bash "$INSTALL_DIR/stop.sh"
}

cmd_status() {
    echo -e "${CYAN}Codex Agent Worker${NC}"
    echo -e "  Version:  ${GREEN}${VERSION}${NC}"
    echo -e "  Install:  $INSTALL_DIR"
    echo -e "  Port:     $PORT"

    PIDS=$(lsof -ti:$PORT 2>/dev/null || true)
    if [ -n "$PIDS" ]; then
        echo -e "  Status:   ${GREEN}RUNNING${NC} (PID: $PIDS)"
        HEALTH=$(curl -s --max-time 3 "http://localhost:$PORT/health" 2>/dev/null || echo "")
        if [ -n "$HEALTH" ]; then
            echo -e "  Health:   $HEALTH"
        fi
    else
        echo -e "  Status:   ${GRAY}STOPPED${NC}"
    fi
}

cmd_version() {
    echo "codex-worker $VERSION"
}

cmd_logs() {
    LOG_FILE="$INSTALL_DIR/logs/worker.log"
    if [ -f "$LOG_FILE" ]; then
        tail -f "$LOG_FILE"
    else
        echo -e "${YELLOW}No log file found at $LOG_FILE${NC}"
        echo -e "${YELLOW}The worker may not have been started yet.${NC}"
    fi
}

cmd_upgrade() {
    local UPDATE_SCRIPT="$INSTALL_DIR/update-worker.sh"
    if [ ! -f "$UPDATE_SCRIPT" ]; then
        echo -e "${RED}update-worker.sh not found at $INSTALL_DIR${NC}"
        echo -e "${YELLOW}Install a release that includes the worker self-update script first.${NC}"
        return 1
    fi
    bash "$UPDATE_SCRIPT" "$@"
}

cmd_upgrade_sdk() {
    local UPDATE_SCRIPT="$INSTALL_DIR/update-sdk.sh"
    if [ ! -f "$UPDATE_SCRIPT" ]; then
        echo -e "${RED}update-sdk.sh not found at $INSTALL_DIR${NC}"
        echo -e "${YELLOW}Your install may predate the upgrade-sdk feature. Run 'codex-worker upgrade' first${NC}"
        echo -e "${YELLOW}to pull a newer worker version that ships update-sdk.sh.${NC}"
        return 1
    fi
    bash "$UPDATE_SCRIPT" "$@"
}

cmd_help() {
    echo "codex-worker v${VERSION} -- Codex Agent Worker CLI"
    echo ""
    echo "Usage: codex-worker <command> [options]"
    echo ""
    echo "Commands:"
    echo "  start                Start the worker service"
    echo "  stop                 Stop the worker service"
    echo "  status               Show worker status and health"
    echo "  version              Show installed version"
    echo "  logs                 Tail worker log output"
    echo "  upgrade [opts]       Upgrade the worker itself from OBS or a local archive"
    echo "                         opts: [archive], --url <base-url>, --force, --no-restart"
    echo "  upgrade-sdk [opts]   Upgrade only @openai/codex-sdk in-place"
    echo "                         opts: --sdk-version <ver>, --no-restart, --registry <url>, --force"
    echo "  help                 Show this help message"
    echo ""
    echo "Environment:"
    echo "  CODEX_WORKER_HOME   Install directory (default: ~/.codex-worker)"
    echo "  CODEX_WORKER_URL    OBS/HTTP base URL for auto-upgrade"
    echo "  CODEX_WORKER_AUTO_UPDATE_SDK=false disables startup SDK repair"
    echo ""
    echo "Config: $INSTALL_DIR/.env"
}

case "${1:-help}" in
    start) cmd_start ;;
    stop) cmd_stop ;;
    status) cmd_status ;;
    version|-v|--version) cmd_version ;;
    logs) cmd_logs ;;
    upgrade) shift; cmd_upgrade "$@" ;;
    upgrade-sdk) shift; cmd_upgrade_sdk "$@" ;;
    help|--help|-h) cmd_help ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        cmd_help
        exit 1
        ;;
esac
