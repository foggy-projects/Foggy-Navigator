RELEASE_OBS_BUCKET=obs://your-bucket/navigator-upstream-cli
RELEASE_BASE_URL=https://your-public-host/navigator-upstream-cli
# Optional absolute path to obsutil. Defaults to `obsutil` on PATH.
OBSUTIL_BIN=obsutil
# Optional path to an obsutil config file; useful when WSL consumes a mounted host config.
OBSUTIL_CONFIG_FILE=
