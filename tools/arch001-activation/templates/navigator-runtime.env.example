# Render placeholders inside the target-owned gitignored root; chmod 0600.
SERVER_PORT=__NAVIGATOR_PORT__
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:__MYSQL_PORT__/__DATABASE__?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=__DATABASE_USER__
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
NAVIGATOR_RUNTIME_AUDIT_TERMINATION_RECEIPT_ENABLED=true
NAVIGATOR_EXTERNAL_ENABLED=false
NAVIGATOR_WORKER_GATEWAY_EXTERNAL_ENABLED=false
NAVIGATOR_LIFECYCLE_SHADOW_ENABLED=false
