# Keep both switches false in implementation and signoff sessions.
# A later execution session may render true only after independent authorization
# and a separate user approval for the exact runId and one submission.
NAVIGATOR_LIFECYCLE_ACTIVATION_CONTROL_TOKEN=
NAVIGATOR_LIFECYCLE_ACTIVATION_CONTROL_ENABLED=false
NAVIGATOR_LIFECYCLE_ACTIVATION_ADMISSION_ENABLED=false
NAVIGATOR_LIFECYCLE_ACTIVATION_EXACT_TARGET_ID=__TARGET_ID__
NAVIGATOR_LIFECYCLE_ACTIVATION_MANIFEST_PATH=__TARGET_ROOT__/activation-target-manifest.json
NAVIGATOR_LIFECYCLE_ACTIVATION_OBSERVATION_PATH=__TARGET_ROOT__/controller-observation.json
NAVIGATOR_LIFECYCLE_ACTIVATION_INSTANCE_ID=__INSTANCE_ID__
NAVIGATOR_LIFECYCLE_ACTIVATION_CANDIDATE_HEAD=__CANDIDATE_HEAD__
NAVIGATOR_LIFECYCLE_ACTIVATION_CANDIDATE_PATCH_SHA256=__CANDIDATE_PATCH_SHA256__
NAVIGATOR_LIFECYCLE_ACTIVATION_OWNER_PROTOCOL=1
NAVIGATOR_LIFECYCLE_ACTIVATION_PROOF_LEASE=PT30S
NAVIGATOR_LIFECYCLE_ACTIVATION_INSTANCE_TTL=PT30S
NAVIGATOR_LIFECYCLE_ACTIVATION_OBSERVATION_MAX_AGE=PT15S
NAVIGATOR_LIFECYCLE_ACTIVATION_OBSERVER_DELAY=PT5S
